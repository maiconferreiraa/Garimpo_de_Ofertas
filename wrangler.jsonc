// Site Ester Garimpou na Cloudflare (migração da Netlify, 2026-11-07).
// Publicar: npx wrangler@4 deploy  (a partir desta pasta)
{
  "name": "estergarimpou",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2025-09-01",
  "alias": { "@netlify/blobs": "./cloudflare/blobs.mjs" },
  "assets": { "directory": ".", "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "estergarimpou", "database_id": "81ea0928-b339-486b-a23b-6be844215d65" }],
  "kv_namespaces": [{ "binding": "ARQUIVOS", "id": "afba53e98c764d2ea00b48ddb23cc694" }],
  "observability": { "enabled": true }
}
